STEAM_API_KEY=
DATABASE_URL=postgresql+psycopg://cs2trade:cs2trade@postgres:5432/cs2trade
REDIS_URL=redis://redis:6379/0

# Connexion Steam (OpenID). En local, laisser tel quel.
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# false uniquement en local sans HTTPS. Toujours true en production.
COOKIE_SECURE=true
# Lu par apps/web (cote navigateur) pour appeler l'API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optionnel, tier premium uniquement (IA investisseur). Vide = les endpoints
# /me/investor-advice echouent, mais tout le reste de l'outil (calcul
# deterministe, gratuit) fonctionne sans.
# Fournisseur actif : anthropic (defaut) ou groq (cle gratuite, console.groq.com/keys).
LLM_PROVIDER=anthropic
# Cle Anthropic standard (https://console.anthropic.com/settings/keys).
ANTHROPIC_API_KEY=
# Cle Groq, lue seulement si LLM_PROVIDER=groq (https://console.groq.com/keys).
GROQ_API_KEY=
# Optionnel. Defaut : claude-opus-5 (anthropic) ou openai/gpt-oss-120b (groq).
LLM_MODEL=
